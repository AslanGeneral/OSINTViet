# ============================================================
# .env.example — sao chép thành .env rồi điền giá trị thật.
# .env và keys_pool.json đã nằm trong .gitignore [AR §7.3 / BM].
# ============================================================

# ---- Database (file .db KHÔNG commit; bảng khởi tạo bằng app/core/database.py)
DATABASE_URL=sqlite+aiosqlite:///./osint_macro.db

# ---- Embedding v2.0: Cohere Embed v5 Pro + Fallback Ollama [DT §6.1.1]
# auto: có COHERE_API_KEY thì dùng Cohere, ngược lại dùng Ollama local.
EMBEDDING_PROVIDER=auto
COHERE_API_KEY=
# Tương thích .env cũ; nếu trống dùng COHERE_EMBED_MODEL.
EMBED_MODEL=
COHERE_EMBED_MODEL=embed-v5.0-pro
COHERE_EMBED_ENDPOINT=https://api.cohere.com/v2/embed
COHERE_EMBED_BATCH_SIZE=96
EMBEDDING_MODEL=embeddinggemma-2:740m
EMBEDDING_DIMENSION=256
EMBEDDING_HTTP_TIMEOUT_SECONDS=25.0
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=osint_macro_knowledge

# Anchor mặc định. Điền EMBEDDING_DOMAIN_STATEMENT để engine tự ghép
# domain statement vào anchor dương/âm mà không cần sửa orchestrator.
EMBEDDING_DOMAIN_STATEMENT=
EMBEDDING_POSITIVE_ANCHOR=Bằng chứng có nguồn kiểm chứng, số liệu thống kê, phân tích chính sách và tác động kinh tế - xã hội.
EMBEDDING_NEGATIVE_ANCHOR=Quảng cáo, khuyến mãi, bài PR, tin đồn không nguồn, nội dung giật gân.
INGESTION_CONTRASTIVE_THRESHOLD=0.42
CONTRASTIVE_NEGATIVE_MARGIN=0.30
CONTRASTIVE_NEGATIVE_WEIGHT=0.50

# ---- Search-error checking (Appendix A hàng 4/5/7/8/9 — đã chốt)
CRAG_CORRECT_THRESHOLD=0.62
CRAG_AMBIGUOUS_THRESHOLD=0.40
MMR_BETA=0.70
MMR_TIME_DECAY_GAMMA=0.005
DECOMPOSE_KEEP_THRESHOLD=0.48
NUMERICAL_CV_THRESHOLD=0.35
PROXIMITY_SIMILARITY_THRESHOLD=0.86

# ---- Sample macro news ingestor (danh sách URL bài viết, phẩy cách)
MACRO_NEWS_SOURCES=
MACRO_NEWS_MAX_ARTICLES=10

# ---- Negative Memory + Sandbox HMAC
NEGATIVE_MEMORY_DECAY_FACTOR=0.60
VERIFIER_COMPILED_MEMORY_PATH=./verifier_compiled_memory.json
SOVEREIGN_SANDBOX_SECRET=change_this_hmac_secret

# ---- Key Pool [DT §6.2]
# 14 key Gemini 3.8 Flash (14 GCP project), phẩy cách:
GEMINI_API_KEYS=
# 3 API khác, mỗi entry dạng base_url|api_key|model, phẩy cách:
EXTRA_API_KEYS=
# Hoặc dùng keys_pool.json (không commit) với cấu trúc:
# [{"name":"gcp_p01","base_url":"...","api_key":"...","model":"gemini-3.8-flash","capabilities":["worker","judge"]}]
UCB1_EXPLORATION_C=1.0

# ---- LLM Router cũ (giữ tương thích app/services/llm_engine.py)
TOURNAMENT_API_KEY=
LLM_PROVIDER=local_ollama
LOCAL_OLLAMA_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=llama3.2:3b
# Keep one request/model slot on the 7.6 GB reference host.
LOCAL_LLM_CONCURRENCY=1
LOCAL_LLM_NUM_CTX=4096
LOCAL_LLM_TIMEOUT_SECONDS=600
CLOUD_API_KEY=
CLOUD_API_BASE_URL=https://api.openai.com/v1
CLOUD_MODEL_NAME=gpt-4o-mini

# ---- Full-circle live workflow
WORKFLOW_ARTIFACT_DIR=/tmp/osint_workflow
WORKFLOW_ECON_FETCH_SOURCES=https://vnexpress.net/kinh-doanh,https://vneconomy.vn/tieu-diem.htm
WORKFLOW_ECON_FETCH_MAX_ATTEMPTS=3
WORKFLOW_ECON_FETCH_ARTICLE_ATTEMPTS=3
WORKFLOW_WORD_FILTER_MIN_TERMS=3
WORKFLOW_WORD_FILTER_MIN_SCORE=0.35
WORKFLOW_WORD_FILTER_MIN_ANALYSIS_RELEVANCE=0.45
WORKFLOW_WORLD_BANK_BASE_URL=https://api.worldbank.org/v2
WORKFLOW_WORLD_BANK_COUNTRY=VNM
WORKFLOW_ARIMA_FORECAST_STEPS=6
WORKFLOW_MIN_STATS_POINTS=30
