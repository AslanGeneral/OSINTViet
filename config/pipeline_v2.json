  "cache_log": {
    "purge_enabled": true,
    "dry_run_default": false,
    "store_embedding_vectors": true,
    "max_content_chars": 20000
  },
  "revalidation": {
    "grounding_similarity_threshold": 0.34,
    "consistency_similarity_threshold": 0.28,
    "lexical_overlap_threshold": 0.18,
    "min_claim_support_ratio": 0.8,
    "require_external_support": true,
    "embedding_batch_size": 16,
    "append_failure_lessons": false,
    "_calibration_notes": "Initial operating points chosen after reviewing claim/evidence cosine similarity on the project's Vietnamese macro/micro sample set; re-calibrate on audited production pairs before tightening. Lexical fallback threshold uses token-overlap Jaccard."
  },
  "input_fetch": {
    "require_live_article": false,
    "analyze_article": true,
    "max_article_chars": 6000,
    "fetch_attempts": 2,
    "query_breakdown_enabled": true,
    "query_breakdown_llm_enabled": true
  },
  "query_breakdown": {
    "indicator_terms": {
      "GDP_YOY": ["gdp", "tăng trưởng"],
      "CPI_YOY": ["lạm phát", "cpi", "giá tiêu dùng"],
      "FX_DEPREC": ["tỷ giá", "mất giá", "phá giá"],
      "IB_RATE": ["lãi suất", "lãi vay"],
      "UNEMPLOYMENT": ["thất nghiệp", "việc làm"],
      "CREDIT_GROWTH": ["tín dụng", "cho vay"],
      "NPL_RATIO": ["nợ xấu", "npl"],
      "FX_RESERVES": ["dự trữ ngoại hối"]
    },
    "personal_dimension_terms": {
      "income": ["thu nhập", "lương", "income"],
      "expenditure": ["chi tiêu", "chi phí", "expense", "spending"],
      "savings": ["tiết kiệm", "tiền mặt", "savings", "liquid"],
      "debt": ["nợ", "khoản vay", "debt", "loan"],
      "household_size": ["người lớn", "trẻ em", "con", "adults", "children"],
      "housing": ["nhà ở", "tiền thuê", "housing", "rent"],
      "energy": ["xăng", "điện", "năng lượng", "energy", "fuel"],
      "health": ["y tế", "bảo hiểm", "health", "insurance"],
      "education": ["học phí", "trường học", "education", "tuition"]
    },
    "search_query_templates": [
      "{query}",
      "{query} Việt Nam số liệu mới nhất",
      "{query} tác động hộ gia đình"
    ]
  },
  "byok": {
    "api_key_env": "OSINT_BYOK_API_KEY",
    "base_url_env": "OSINT_BYOK_BASE_URL",
    "model_env": "OSINT_BYOK_MODEL",
    "default_base_url": "http://127.0.0.1:3001/v1",
    "default_model": "gemini-3.8-flash",
    "timeout_seconds": 180.0
  },
  "orchestrator": {
    "enabled": true,
    "disable_raw_ingestors": true,
    "domain_tag": "macro_econ",
    "timeout_seconds": 2700.0
  },
  "macro": {
    "artifact_subdir": "macro",
    "country_code": "VNM"
  },
  "micro": {
    "household_config_path": "config/micro_household.json",
    "channels_path": "config/micro_channels.json"
  }
